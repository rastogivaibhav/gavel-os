enforcer/*.exe
enforcer/gavel-enforcer-*

# VS Code extension build artifacts and dependencies
vscode-extension/dist/
vscode-extension/node_modules/
vscode-extension/coverage/
vscode-extension/*.vsix

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
.venv/
venv/
env/

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment files (contain secrets)
.env
.env.*
!.env.example

# JWT keys (auto-generated, never commit)
control-plane/auth/keys/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
.coverage
htmlcov/
.pytest_cache/
coverage.xml

# Helm chart dependencies
deploy/helm/charts/
deploy/helm/*.lock

# Temporary files created by start scripts
/tmp/gavel-*

# Node.js / Tailwind
control-plane/node_modules/
control-plane/package-lock.json
control-plane/static/css/output.css.map

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
