# Enforce LF line endings for all text files across platforms
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pyc binary
*.pyd binary
*.so binary
*.dll binary
*.exe binary
