# Gavel OS — Environment Configuration
# Copy this file to .env and fill in values before starting.
# NEVER commit .env to version control.

# ── Port overrides ────────────────────────────────────────────────────────────
# Default ports are chosen to avoid conflicts with common dev tools.
# Override any of these if they clash with something on your machine.
GAVEL_API_PORT=18000      # Control plane REST API  (default: 18000)
GAVEL_GRPC_PORT=18051     # gRPC ext_authz          (default: 18051)
OPA_PORT=18181            # OPA policy engine       (default: 18181)

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | production
ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the audit ledger.
DATABASE_URL=postgres://gavel:changeme@localhost:5432/gavel

# ── Cache ─────────────────────────────────────────────────────────────────────
# Redis connection string for rate limiting and session cache.
REDIS_URL=redis://:changeme@localhost:6379/0

# ── OPA Policy Engine ─────────────────────────────────────────────────────────
# URL of the Open Policy Agent HTTP API.
OPA_URL=http://localhost:8181

# OPA Rego package path for authorization decisions.
# Default: sentinel/api/authz (matches policies/rego/authz.rego)
OPA_PACKAGE_PATH=sentinel/api/authz

# OPA request timeout in seconds.
OPA_TIMEOUT_SECONDS=2.0

# ── Authentication ────────────────────────────────────────────────────────────
# Shared secret for machine-to-control-plane authentication.
# Must match GAVEL_MACHINE_KEY set on each enforcer host.
# Generate with: openssl rand -hex 32
GAVEL_MACHINE_KEY=

# API key for external REST clients (Prometheus scrape, dashboards).
# Generate with: openssl rand -hex 32
API_SECRET_KEY=

# Secret required to mint admin-role JWT tokens.
# Generate with: openssl rand -hex 32
ADMIN_SECRET_KEY=

# Secret for the Prometheus /metrics scrape endpoint.
# Generate with: openssl rand -hex 16
METRICS_SECRET_KEY=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Token expiry in seconds. Default: 3600 (1 hour).
JWT_EXPIRY_SECONDS=3600

# Paths to RSA key files. If not set, keys are auto-generated to auth/keys/.
# In production, mount these from a secret store.
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Development Overrides ─────────────────────────────────────────────────────
# WARNING: Setting ALLOW_INSECURE_DEV_AUTH=true bypasses all authentication.
# The control plane will REFUSE TO START if this is true and ENV != development.
ALLOW_INSECURE_DEV_AUTH=false

# ── Enforcer Runtime Policy ───────────────────────────────────────────────────
# These are used when the enforcer runs without a control-plane connection.
# In production, policy is fetched from the control plane via machine auth.

# Comma-separated list of PIDs to monitor (Linux eBPF enforcer).
# GAVEL_MONITORED_PIDS=

# Comma-separated list of IPv4 addresses to block (Linux eBPF enforcer).
# GAVEL_BLOCKED_IPS=

# Proxy redirect for eBPF traffic interception (Linux only).
# GAVEL_PROXY_IPV4=
# GAVEL_PROXY_PORT=

# Comma-separated list of hostnames/IPs to block (Windows WFP enforcer).
# GAVEL_RUNTIME_BLOCKED_TARGETS=

# Comma-separated list of process names to monitor (Windows enforcer).
# GAVEL_RUNTIME_MONITORED_PROCESSES=

# Policy version tag returned to enforcers.
GAVEL_RUNTIME_POLICY_VERSION=2026-04-21

# ── gRPC ext_authz TLS ────────────────────────────────────────────────────────
# In production, provide TLS certificates for the gRPC ext_authz server.
# The control plane will refuse to start with GRPC_INSECURE=true unless ENV=development.
#
# Server-side TLS (minimum for production):
# GRPC_TLS_CERT_PATH=/run/secrets/grpc_server.crt
# GRPC_TLS_KEY_PATH=/run/secrets/grpc_server.key
#
# mTLS (recommended — also verifies Envoy client certificate):
# GRPC_CA_CERT_PATH=/run/secrets/grpc_ca.crt
#
# Development only — generates a self-signed cert automatically:
# GRPC_INSECURE=true   ← only works when ENV=development
GRPC_INSECURE=true
GRPC_PORT=50051

# Directory where the auto-generated dev TLS cert is written (dev only).
GRPC_DEV_CERT_DIR=/tmp/gavel-grpc-dev

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Per-enforcer-host limits on the machine-facing endpoints.
# Format: <count>/<period>  e.g. 200/minute, 10/second
RATE_LIMIT_VALIDATE=200/minute
RATE_LIMIT_HEARTBEAT=4/minute
RATE_LIMIT_TELEMETRY=300/minute
RATE_LIMIT_POLICY=30/minute

# ── JWT Key Rotation / JWKS ───────────────────────────────────────────────────
# Optional: URL of an external JWKS endpoint for key rotation.
# When set, tokens signed by any key in the JWKS are accepted in addition
# to the local key. Useful during rolling key rotation.
# JWKS_URL=https://auth.example.com/.well-known/jwks.json

# How long (seconds) to cache the remote JWKS before re-fetching.
JWKS_CACHE_TTL_SECONDS=300

# Optional: override the key ID (kid) embedded in issued JWTs.
# Defaults to a hash of the local public key.
# JWT_KEY_ID=my-key-v1
# Set to true to enable OTLP trace export (Jaeger, Datadog, etc.)
ENABLE_OTLP=false

# OTLP collector endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Set to true if the OTLP endpoint does not use TLS.
OTEL_EXPORTER_OTLP_INSECURE=false

# ── Enforcer (set on enforcer hosts, not the control plane) ──────────────────
# URL of the Gavel control plane.
# GAVEL_ENGINE_URL=http://localhost:8000

# Fail-open mode: if true, the enforcer allows traffic when the control plane
# is unreachable. Default is fail-closed (false). Use with extreme caution.
# GAVEL_FAIL_OPEN=false

# Force Windows enforcer to audit-only mode regardless of capabilities.
# GAVEL_WINDOWS_MODE=audit_only

# DNS refresh interval for WFP hostname-based rules (Windows).
# GAVEL_WINDOWS_DNS_REFRESH_INTERVAL=5m
